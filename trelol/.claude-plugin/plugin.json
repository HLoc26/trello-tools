{
    "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
    "name": "trelol",
    "version": "0.3.0",
    "description": "Trello sprint tools: refine cards into specs + checklists, then implement them with live checklist progress.",
    "author": {
        "name": "hloc"
    },
    "userConfig": {
        "trelloApiKey": {
            "type": "string",
            "title": "Trello API key",
            "description": "Trello API key from https://trello.com/app-key"
        },
        "trelloToken": {
            "type": "string",
            "title": "Trello token",
            "description": "Trello API token"
        }
    }
}
